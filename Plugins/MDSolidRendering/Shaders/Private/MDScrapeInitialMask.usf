#include "/Engine/Public/Platform.ush"
int2 Size;
StructuredBuffer<uint> Sources;
StructuredBuffer<uint> ActiveBits;
StructuredBuffer<uint> SeamBytes;
RWTexture2D<float> OutMask;
[numthreads(8,8,1)]
void MainCS(uint3 ThreadId : SV_DispatchThreadID)
{
    if (any(ThreadId.xy >= uint2(Size))) return;
    uint Source = Sources[ThreadId.x + ThreadId.y * Size.x];
    uint Value = 0;
    if (Source != 0xffffffffu)
    {
        if ((Source & 0x80000000u) != 0)
        {
            uint Seam = Source & 0x7fffffffu;
            Value = (SeamBytes[Seam >> 2u] >> ((Seam & 3u) * 8u)) & 255u;
        }
        else Value = ((ActiveBits[Source >> 5u] >> (Source & 31u)) & 1u) * 255u;
    }
    OutMask[ThreadId.xy] = float(Value) / 255.0;
}
