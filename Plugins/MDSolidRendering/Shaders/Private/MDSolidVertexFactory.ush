// Geometry deformation is performed by the GPU for every material, depth and shadow draw.
// Reuse UE's local material/lighting interface after loading the compact solid attributes.
#define GetVertexFactoryIntermediates MDSolidBaseGetIntermediates
#define VertexFactoryGetWorldPosition MDSolidBaseGetWorldPosition
#define VertexFactoryGetPreviousWorldPosition MDSolidBaseGetPreviousWorldPosition
#define VertexFactoryGetInstanceSpacePosition MDSolidBaseGetInstanceSpacePosition
#define VertexFactoryGetPreviousInstanceSpacePosition MDSolidBaseGetPreviousInstanceSpacePosition
#define GetMaterialVertexParameters MDSolidBaseGetMaterialVertexParameters
#define VertexFactoryGetInterpolantsVSToPS MDSolidBaseGetInterpolants
#include "/Engine/Private/LocalVertexFactory.ush"
#undef GetVertexFactoryIntermediates
#undef VertexFactoryGetWorldPosition
#undef VertexFactoryGetPreviousWorldPosition
#undef VertexFactoryGetInstanceSpacePosition
#undef VertexFactoryGetPreviousInstanceSpacePosition
#undef GetMaterialVertexParameters
#undef VertexFactoryGetInterpolantsVSToPS

struct FMDSolidShaderVertex
{
    float3 BasePosition;
    float3 OffsetPerCm;
    float2 UV;
    uint HeightIndex;
    uint NormalIndex;
    float HeightScale;
};

FMDSolidShaderVertex MDSolidLoadTemplate(uint VertexId)
{
    uint B = VertexId * 11;
    FMDSolidShaderVertex V;
    V.BasePosition = asfloat(uint3(MDSolidVF.TemplateVertices[B], MDSolidVF.TemplateVertices[B + 1], MDSolidVF.TemplateVertices[B + 2]));
    V.OffsetPerCm = asfloat(uint3(MDSolidVF.TemplateVertices[B + 3], MDSolidVF.TemplateVertices[B + 4], MDSolidVF.TemplateVertices[B + 5]));
    V.UV = asfloat(uint2(MDSolidVF.TemplateVertices[B + 6], MDSolidVF.TemplateVertices[B + 7]));
    V.HeightIndex = MDSolidVF.TemplateVertices[B + 8];
    V.NormalIndex = MDSolidVF.TemplateVertices[B + 9];
    V.HeightScale = asfloat(MDSolidVF.TemplateVertices[B + 10]);
    return V;
}

float3 MDSolidPosition(FMDSolidShaderVertex V)
{
    return V.BasePosition + V.OffsetPerCm * (MDSolidVF.State[V.HeightIndex] * V.HeightScale);
}

FVertexFactoryInput MDSolidLoadInput(FVertexFactoryInput Input)
{
    FMDSolidShaderVertex V = MDSolidLoadTemplate(Input.VertexId);
    Input.Position = float4(MDSolidPosition(V), 1);
    uint N = MDSolidVF.NormalOffset + V.NormalIndex * 3;
    float3 Normal = float3(MDSolidVF.State[N], MDSolidVF.State[N + 1], MDSolidVF.State[N + 2]);
    Normal = dot(Normal, Normal) > 1e-20 ? normalize(Normal) : float3(0, 0, 1);
    float3 ReferenceAxis = abs(Normal.z) < 0.999 ? float3(0, 0, 1) : float3(0, 1, 0);
    float3 Tangent = normalize(cross(ReferenceAxis, Normal));
    float TangentSign = 1;
    BRANCH
    if (MDSolidVF.UseUVTangents != 0)
    {
        uint First = (Input.VertexId / 3) * 3;
        FMDSolidShaderVertex A = MDSolidLoadTemplate(First);
        FMDSolidShaderVertex B = MDSolidLoadTemplate(First + 1);
        FMDSolidShaderVertex C = MDSolidLoadTemplate(First + 2);
        float3 E1 = MDSolidPosition(B) - MDSolidPosition(A);
        float3 E2 = MDSolidPosition(C) - MDSolidPosition(A);
        float2 UV1 = B.UV - A.UV;
        float2 UV2 = C.UV - A.UV;
        float Det = UV1.x * UV2.y - UV1.y * UV2.x;
        if (abs(Det) > 1e-12)
        {
            float3 U = (E1 * UV2.y - E2 * UV1.y) / Det;
            float3 VAxis = (E2 * UV1.x - E1 * UV2.x) / Det;
            U -= Normal * dot(Normal, U);
            if (dot(U, U) > 1e-20)
            {
                Tangent = normalize(U);
                TangentSign = dot(cross(Normal, Tangent), VAxis) < 0 ? -1 : 1;
            }
        }
    }
    Input.TangentX = Tangent;
    Input.TangentZ = float4(Normal, TangentSign);
    Input.Color = float4(1, 1, 1, 1);
#if NUM_MATERIAL_TEXCOORDS_VERTEX > 1
    Input.TexCoords0 = V.UV.xyxy;
#elif NUM_MATERIAL_TEXCOORDS_VERTEX == 1 || USE_PARTICLE_SUBUVS
    Input.TexCoords0 = V.UV;
#endif
#if NUM_MATERIAL_TEXCOORDS_VERTEX > 3
    Input.TexCoords1 = V.UV.xyxy;
#elif NUM_MATERIAL_TEXCOORDS_VERTEX == 3
    Input.TexCoords1 = V.UV;
#endif
#if NUM_MATERIAL_TEXCOORDS_VERTEX > 5
    Input.TexCoords2 = V.UV.xyxy;
#elif NUM_MATERIAL_TEXCOORDS_VERTEX == 5
    Input.TexCoords2 = V.UV;
#endif
#if NUM_MATERIAL_TEXCOORDS_VERTEX > 7
    Input.TexCoords3 = V.UV.xyxy;
#elif NUM_MATERIAL_TEXCOORDS_VERTEX == 7
    Input.TexCoords3 = V.UV;
#endif
#if NEEDS_LIGHTMAP_COORDINATE
    Input.LightMapCoordinate = V.UV;
#endif
    return Input;
}

FVertexFactoryIntermediates GetVertexFactoryIntermediates(FVertexFactoryInput Input)
{
    return MDSolidBaseGetIntermediates(MDSolidLoadInput(Input));
}

float4 VertexFactoryGetWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
    return MDSolidBaseGetWorldPosition(MDSolidLoadInput(Input), Intermediates);
}

float4 VertexFactoryGetPreviousWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
    // Match the previous dynamic mesh path: current deformation, previous primitive transform.
    return MDSolidBaseGetPreviousWorldPosition(MDSolidLoadInput(Input), Intermediates);
}

float3 VertexFactoryGetInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
    return MDSolidBaseGetInstanceSpacePosition(MDSolidLoadInput(Input), Intermediates);
}

float3 VertexFactoryGetPreviousInstanceSpacePosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
{
    return MDSolidBaseGetPreviousInstanceSpacePosition(MDSolidLoadInput(Input), Intermediates);
}

FMaterialVertexParameters GetMaterialVertexParameters(FVertexFactoryInput Input,
    FVertexFactoryIntermediates Intermediates, float3 WorldPosition, half3x3 TangentToLocal, bool bIsPreviousFrame = false)
{
    return MDSolidBaseGetMaterialVertexParameters(MDSolidLoadInput(Input), Intermediates, WorldPosition,
        TangentToLocal, bIsPreviousFrame);
}

FVertexFactoryInterpolantsVSToPS VertexFactoryGetInterpolantsVSToPS(FVertexFactoryInput Input,
    FVertexFactoryIntermediates Intermediates, FMaterialVertexParameters Parameters)
{
    return MDSolidBaseGetInterpolants(MDSolidLoadInput(Input), Intermediates, Parameters);
}

// Position-only permutations are deliberately unsupported: they would bypass the state lookup.
// Depth and shadow passes therefore use the complete vertex factory and identical displacement.
