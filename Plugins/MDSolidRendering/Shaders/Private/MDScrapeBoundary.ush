#ifndef MD_SCRAPE_BOUNDARY_USH
#define MD_SCRAPE_BOUNDARY_USH
// Only the address is reconstructed. Never threshold or remap the encoded dirt/paint signal:
// MD_ScrapeMaskAtlas already contains the covered-area / residual-film response.
float2 MDScrapeBoundaryUV(float2 UV, float2 Size, float NarrowTransition)
{
    Size = max(Size, 1.0);
    float2 Texel = UV * Size - 0.5;
    // Evaluate derivatives before floor/frac, including on atlas chart boundaries.
    float2 Footprint = saturate(fwidth(Texel));
    float2 Base = floor(Texel);
    float2 Fraction = Texel - Base;
    // A mild Hermite weight narrows the magnified transition, reverting to linear
    // reconstruction at one texel per screen pixel. Constant films and cell centers
    // are exact fixed points. The coefficient bounds displacement to <0.025 texel.
    float2 Hermite = Fraction * Fraction * (3.0 - 2.0 * Fraction);
    // Existing dirt already has linear reconstruction. Keep that affine response;
    // only the newly reconstructed paint path opts into the narrow transition.
    float2 Weight = lerp(Fraction, Hermite, 0.25 * NarrowTransition * (1.0 - Footprint));
    // One bilinear footprint only: the baked one-cell PRIVATE chart gutter is enough.
    // No offset taps, anisotropic footprint, mip pyramid or unrelated atlas island.
    return clamp(Base + Weight + 0.5, 0.5, Size - 0.5) / Size;
}
#endif

#ifndef MD_SCRAPE_SDF_USH
#define MD_SCRAPE_SDF_USH
// Geometry and residual-film values are authored independently. The narrow
// transition is measured in screen pixels, and cannot widen a coarse G8 edge.
float MDScrapeFootprintBoundary(
    float2 UV,float2 Size,float Fallback,float Enabled,
    Texture2D Atlas,SamplerState AtlasSampler,
    Texture2D Low,SamplerState LowSampler,Texture2D High,SamplerState HighSampler)
{
    float2 P=clamp(UV*Size,0.0001,Size-0.0001);
    float2 ScreenFootprint=fwidth(P);
    if (Enabled<0.5) return Fallback;
    float2 Tile=floor(P/8.0);
    float2 MapSize=ceil(Size/8.0);
    float2 PageUV=(Tile+0.5)/MapSize;
    float Encoded=round(Texture2DSampleLevel(Low,LowSampler,PageUV,0).r*255.0)
        +256.0*round(Texture2DSampleLevel(High,HighSampler,PageUV,0).r*255.0);
    if (Encoded<0.5) return Fallback;
    float Slot=Encoded-1.0;
    float2 Physical=float2(fmod(Slot,25.0),floor(Slot/25.0))*80.0;
    float2 FieldUV=(Physical+8.0+(P-Tile*8.0)*8.0)/2048.0;
    float4 Field=Texture2DSampleLevel(Atlas,AtlasSampler,FieldUV,0);
    float PixelWidth=max(fwidth(Field.x),0.0001);
    float Coverage=saturate(0.5-Field.x/PixelWidth);
    float Reconstructed=lerp(Field.y,Field.z,Coverage);
    // Existing filtered representation is the bounded minification fallback.
    float Magnified=1.0-smoothstep(0.75,1.5,max(ScreenFootprint.x,ScreenFootprint.y));
    return lerp(Fallback,Reconstructed,Magnified*step(0.999,Field.w));
}
#endif
